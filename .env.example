# Dshell Environment Configuration Template
# Copy this file to .env and configure as needed
# NEVER commit .env files with actual secrets to version control

# =============================================================================
# GeoIP Configuration
# =============================================================================
# Path to MaxMind GeoIP database files (optional)
# Download from: https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
GEOIP_DATABASE_PATH=/path/to/GeoLite2-City.mmdb
GEOIP_ASN_DATABASE_PATH=/path/to/GeoLite2-ASN.mmdb

# MaxMind license key for automatic database updates (optional)
# MAXMIND_LICENSE_KEY=your_license_key_here

# =============================================================================
# Elasticsearch Output Configuration
# =============================================================================
# Elasticsearch connection settings for elasticout output module
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=your_password_here
# ELASTICSEARCH_API_KEY=your_api_key_here
ELASTICSEARCH_INDEX=dshell-logs
ELASTICSEARCH_USE_SSL=false
# ELASTICSEARCH_CA_CERT=/path/to/ca.crt

# =============================================================================
# SSL Blacklist Configuration
# =============================================================================
# Path to abuse.ch SSL blacklist CSV file
# Download from: https://sslbl.abuse.ch/blacklist/
SSLBLACKLIST_CSV_PATH=./sslblacklist.csv

# =============================================================================
# Logging Configuration
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
DSHELL_LOG_LEVEL=INFO

# Log output file (optional, defaults to stderr)
# DSHELL_LOG_FILE=/var/log/dshell/dshell.log

# Enable structured JSON logging
DSHELL_JSON_LOGGING=false

# =============================================================================
# Security Configuration
# =============================================================================
# Regex operation timeout in seconds (ReDoS protection)
DSHELL_REGEX_TIMEOUT=5.0

# Maximum regex pattern length
DSHELL_MAX_REGEX_LENGTH=10000

# =============================================================================
# Network Capture Configuration
# =============================================================================
# Default network interface for live capture
# DSHELL_INTERFACE=eth0

# BPF filter for packet capture (optional)
# DSHELL_BPF_FILTER=tcp port 80

# =============================================================================
# Plugin Configuration
# =============================================================================
# Path to external plugins directory (optional)
# DSHELL_PLUGINS_PATH=/path/to/custom/plugins

# =============================================================================
# Docker/Container Configuration
# =============================================================================
# Data volume mount point
DSHELL_DATA_DIR=/data

# User ID for container (matches non-root user)
DSHELL_UID=1000
DSHELL_GID=1000
